START_META     =   OBSERVATORY_CAVEATS
    ENTRY = "*C1_CQ"
    ENTRY = "Main planned commissioning events : "
    ENTRY = " - 2000-08-09T11:13Z/2000-08-09T11:13Z :  Launch 2"
    ENTRY = " - 2000-08-09T11:13Z/2000-09-25T22:13Z :  SC not at 15 rpm - starting time"
    ENTRY = " - 2000-08-16T09:00Z/2000-08-16T13:00Z :  ASPOC+CIS cover opening and FGM"
    ENTRY = " - 2000-08-22T18:54Z/2000-08-23T00:25Z :  FGM Switch-on + tests"
    ENTRY = " - 2000-08-29T20:55Z/2000-08-29T21:55Z :  WEC First full WEC on (A.4)"
    ENTRY = " - 2000-09-07T21:22Z/2000-09-07T22:22Z :  WEC Deploy booms 3 & 4 and  to 15 m (B.3)"
    ENTRY = " - 2000-09-07T22:22Z/2000-09-07T23:22Z :  WEC Deploy booms 1 & 2 from 1.3 m to 15 m (B.4)"
    ENTRY = " - 2000-09-07T23:22Z/2000-09-08T00:03Z :  WEC Spin up satellite to 22 rpm + sphere release (B.5)"
    ENTRY = " - 2000-09-20T18:34Z/2000-09-20T19:34Z :  WEC Deploy booms 3 & 4  from 15 m to 35 m (C.2)"
    ENTRY = " - 2000-09-20T19:34Z/2000-09-20T20:04Z :  WEC Deploy booms 1 & 2  from 15 m to 20 m (C.3)"
    ENTRY = " - 2000-09-25T19:18Z/2000-09-25T19:53Z :  WEC Deploy booms 3 & 4 from 35 m to 43 m (D.2)"
    ENTRY = " - 2000-10-06T14:54Z/2000-10-06T17:54Z :  WEC Deploy booms 1 & 2 from 20 m to 43 m (E.2)"
    ENTRY = " - 2000-12-06T11:00Z/2000-12-20T18:30Z :  Interferences + Intercalibration (6 orbits)/ JSOC OBRQ"
END_META       =   OBSERVATORY_CAVEATS

